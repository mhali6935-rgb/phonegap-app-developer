<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>إيقونة الإرشاد التربوي</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        :root {
            --primary: #4361ee;
            --secondary: #3f37c9;
            --success: #4cc9f0;
            --warning: #f72585;
            --light: #f8f9fa;
            --dark: #212529;
            --gray: #6c757d;
            --light-gray: #e9ecef;
            --border-radius: 12px;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s ease;
        }
        
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e4edf5 100%);
            color: #333;
            min-height: 100vh;
            padding-bottom: 70px;
            position: relative;
        }
        
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 120px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            z-index: -1;
        }
        
        .container {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            padding: 15px;
        }
        
        /* Header Styles */
        header {
            text-align: center;
            padding: 20px 0;
            margin-bottom: 20px;
            position: relative;
            z-index: 10;
        }
        
        .app-logo {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, var(--primary), var(--success));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            box-shadow: 0 6px 15px rgba(67, 97, 238, 0.4);
            border: 3px solid white;
        }
        
        .app-logo i {
            font-size: 48px;
            color: white;
        }
        
        h1 {
            color: white;
            font-size: 1.8rem;
            font-weight: 700;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
            margin-bottom: 5px;
        }
        
        .app-slogan {
            color: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
        }
        
        /* Tip Section */
        .tip-section {
            background: white;
            border-radius: var(--border-radius);
            padding: 20px;
            margin-bottom: 25px;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
        }
        
        .tip-section::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            height: 100%;
            width: 5px;
            background: linear-gradient(to bottom, var(--primary), var(--success));
        }
        
        .tip-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        
        .tip-title {
            font-weight: 700;
            color: var(--primary);
            font-size: 1.2rem;
        }
        
        .tip-actions {
            display: flex;
            gap: 10px;
        }
        
        .btn {
            padding: 8px 15px;
            border-radius: 30px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.9rem;
        }
        
        .btn-primary {
            background: var(--primary);
            color: white;
        }
        
        .btn-primary:hover {
            background: var(--secondary);
            transform: translateY(-2px);
        }
        
        .btn-share {
            background: var(--success);
            color: white;
        }
        
        .btn-share:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }
        
        .tip-content {
            line-height: 1.6;
            font-size: 1.05rem;
            color: #444;
            min-height: 60px;
        }
        
        /* Tabs Navigation */
        .tabs {
            display: flex;
            overflow-x: auto;
            gap: 10px;
            padding: 10px 0;
            margin-bottom: 20px;
            scrollbar-width: none;
        }
        
        .tabs::-webkit-scrollbar {
            display: none;
        }
        
        .tab {
            min-width: 120px;
            padding: 10px 15px;
            background: rgba(255, 255, 255, 0.85);
            border-radius: 30px;
            text-align: center;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            border: 1px solid var(--light-gray);
        }
        
        .tab.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 10px rgba(67, 97, 238, 0.3);
        }
        
        .tab:hover:not(.active) {
            background: var(--light);
            transform: translateY(-2px);
        }
        
        /* Form Styles */
        .form-section {
            background: white;
            border-radius: var(--border-radius);
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: var(--shadow);
            display: none;
        }
        
        .form-section.active {
            display: block;
            animation: fadeIn 0.4s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .form-title {
            font-size: 1.5rem;
            color: var(--primary);
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--light-gray);
        }
        
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .form-group {
            flex: 1 0 200px;
            margin-bottom: 15px;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--dark);
        }
        
        input, select, textarea {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid var(--light-gray);
            border-radius: 8px;
            font-size: 1rem;
            transition: var(--transition);
        }
        
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.2);
        }
        
        textarea {
            min-height: 100px;
            resize: vertical;
        }
        
        .radio-group {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 8px;
        }
        
        .radio-option {
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        .image-upload {
            border: 2px dashed var(--light-gray);
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
            margin-bottom: 15px;
        }
        
        .image-upload:hover {
            border-color: var(--primary);
            background: rgba(67, 97, 238, 0.03);
        }
        
        .image-upload i {
            font-size: 2.5rem;
            color: var(--gray);
            margin-bottom: 10px;
        }
        
        .btn-container {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        
        .btn-save {
            background: var(--primary);
            color: white;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
        }
        
        .btn-save i {
            margin-left: 8px;
        }
        
        .btn-reset {
            background: var(--light-gray);
            color: var(--dark);
        }
        
        /* Navigation Bar */
        .nav-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-around;
            padding: 12px 0;
            z-index: 100;
            max-width: 800px;
            margin: 0 auto;
            border-radius: 15px 15px 0 0;
        }
        
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--gray);
            text-decoration: none;
            font-size: 0.85rem;
            transition: var(--transition);
            flex: 1;
        }
        
        .nav-item.active {
            color: var(--primary);
        }
        
        .nav-icon {
            font-size: 1.5rem;
            margin-bottom: 3px;
        }
        
        /* Responsive Design */
        @media (max-width: 480px) {
            .form-row {
                flex-direction: column;
            }
            
            .form-group {
                flex: 1 0 100%;
            }
            
            h1 {
                font-size: 1.5rem;
            }
            
            .app-logo {
                width: 80px;
                height: 80px;
            }
            
            .app-logo i {
                font-size: 36px;
            }
        }
        
        /* Animation for tip change */
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.03); }
            100% { transform: scale(1); }
        }
        
        .pulse {
            animation: pulse 0.4s;
        }
        
        .hidden {
            display: none;
        }
    </style>
</head>
<body>
    <!-- Header with Logo -->
    <header>
        <div class="app-logo">
            <i class="fas fa-graduation-cap"></i>
        </div>
        <h1>إيقونة الإرشاد التربوي</h1>
        <p class="app-slogan">خلق بيئة دراسية خالية من المشاكل والمعوقات</p>
    </header>
    
    <div class="container">
        <!-- Tip Section -->
        <section class="tip-section">
            <div class="tip-header">
                <div class="tip-title"><i class="fas fa-lightbulb"></i> نصيحة اليوم</div>
                <div class="tip-actions">
                    <button class="btn btn-share" id="shareTip"><i class="fas fa-share-alt"></i> مشاركة</button>
                    <button class="btn btn-primary" id="newTip"><i class="fas fa-redo"></i> جديد</button>
                </div>
            </div>
            <div class="tip-content" id="tipContent">
                "الطالب المتميز ليس فقط الذي يحصل على الدرجات العليا، بل الذي يتحلى بأخلاق عالية ويتعاون مع زملائه."
            </div>
        </section>
        
        <!-- Tabs Navigation -->
        <div class="tabs">
            <div class="tab active" data-tab="case-record">سجل الحالة</div>
            <div class="tab" data-tab="key-record">مفتاح الحالة</div>
            <div class="tab" data-tab="talented">المتفوقون والموهوبون</div>
            <div class="tab" data-tab="delayed">المتأخرون دراسياً</div>
            <div class="tab" data-tab="absent">الطلبة الغائبون</div>
            <div class="tab" data-tab="health">الحالة الصحية</div>
            <div class="tab" data-tab="orphans">فاقدي الوالدين</div>
            <div class="tab" data-tab="guidance">الإرشاد الفردي</div>
            <div class="tab" data-tab="annual">الخطة السنوية</div>
            <div class="tab" data-tab="daily-plan">الخطة اليومية</div>
            <div class="tab" data-tab="daily-activity">النشاط اليومي</div>
            <div class="tab" data-tab="events">سجل الفعاليات</div>
        </div>
        
        <!-- Case Record Form -->
        <section id="case-record" class="form-section active">
            <h2 class="form-title">سجل الحالة</h2>
            <form id="caseForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="studentId">رمز الطالب:</label>
                        <input type="text" id="studentId" placeholder="أدخل رمز الطالب">
                    </div>
                    <div class="form-group">
                        <label for="birthDate">تاريخ الميلاد:</label>
                        <input type="date" id="birthDate">
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="parentId">رمز ولي الأمر:</label>
                        <input type="text" id="parentId" placeholder="أدخل رمز ولي الأمر">
                    </div>
                    <div class="form-group">
                        <label for="parentJob">المهنة:</label>
                        <input type="text" id="parentJob" placeholder="أدخل مهنة ولي الأمر">
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="familyMembers">عدد أفراد الأسرة:</label>
                        <input type="number" id="familyMembers" min="1" placeholder="عدد الأفراد">
                    </div>
                    <div class="form-group">
                        <label for="siblings">عدد الإخوة:</label>
                        <input type="number" id="siblings" min="0" placeholder="عدد الإخوة">
                    </div>
                    <div class="form-group">
                        <label for="birthOrder">ترتيب بين أخوته:</label>
                        <input type="number" id="birthOrder" min="1" placeholder="الترتيب">
                    </div>
                </div>
                
                <div class="form-group">
                    <label>يعيش الطالب مع:</label>
                    <div class="radio-group">
                        <div class="radio-option">
                            <input type="radio" id="bothParents" name="livingWith" value="both">
                            <label for="bothParents">الوالدين</label>
                        </div>
                        <div class="radio-option">
                            <input type="radio" id="fatherOnly" name="livingWith" value="father">
                            <label for="fatherOnly">الوالد</label>
                        </div>
                        <div class="radio-option">
                            <input type="radio" id="motherOnly" name="livingWith" value="mother">
                            <label for="motherOnly">الوالدة</label>
                        </div>
                        <div class="radio-option">
                            <input type="radio" id="otherGuardian" name="livingWith" value="other">
                            <label for="otherGuardian">أخرى</label>
                        </div>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="caseDate">تاريخ تسجيل الحالة:</label>
                        <input type="date" id="caseDate">
                    </div>
                    <div class="form-group">
                        <label for="caseSource">مصدر الحالة:</label>
                        <select id="caseSource">
                            <option value="">اختر المصدر</option>
                            <option value="self">ذاتية</option>
                            <option value="family">الأسرة</option>
                            <option value="principal">المدير</option>
                            <option value="teacher">المعلم</option>
                            <option value="counselor">المرشد</option>
                            <option value="other">أخرى</option>
                        </select>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="caseType">نوع الحالة:</label>
                    <select id="caseType" multiple>
                        <option value="psychological">نفسية</option>
                        <option value="educational">تربوية</option>
                        <option value="social">سوء تكيف اجتماعي</option>
                        <option value="family">سوء تكيف داخل الأسرة</option>
                        <option value="health">صحية</option>
                        <option value="financial">مادية (اقتصادية)</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="visitCount">عدد مرات مراجعة الطالب للمرشد:</label>
                    <select id="visitCount">
                        <option value="1">المرة الأولى</option>
                        <option value="2">المرة الثانية</option>
                        <option value="3">المرة الثالثة</option>
                        <option value="4">المرة الرابعة</option>
                    </select>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="firstCaseDate">تاريخ الحالة الأولى:</label>
                        <input type="date" id="firstCaseDate">
                    </div>
                    <div class="form-group">
                        <label for="caseSummary">موجز عن الحالة:</label>
                        <textarea id="caseSummary" placeholder="اكتب ملخصاً عن الحالة"></textarea>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="treatmentGoal">الهدف من البرنامج العلاجي:</label>
                    <textarea id="treatmentGoal" placeholder="اكتب الهدف من البرنامج العلاجي"></textarea>
                </div>
                
                <div class="form-group">
                    <label for="guidanceActions">الإجراءات الإرشادية:</label>
                    <textarea id="guidanceActions" placeholder="اذكر الإجراءات الإرشادية المقترحة"></textarea>
                </div>
                
                <div class="form-group">
                    <label for="caseNotes">ملاحظات المرشد عن تطوير الحالة:</label>
                    <textarea id="caseNotes" placeholder="اكتب الملاحظات"></textarea>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="endDate">تاريخ انتهاء الحالة:</label>
                        <input type="date" id="endDate">
                    </div>
                    <div class="form-group">
                        <label for="sessionsCount">عدد الجلسات:</label>
                        <input type="number" id="sessionsCount" min="1" placeholder="عدد الجلسات">
                    </div>
                </div>
                
                <div class="btn-container">
                    <button type="button" class="btn btn-save"><i class="fas fa-save"></i> حفظ السجل</button>
                    <button type="button" class="btn btn-reset">مسح البيانات</button>
                </div>
            </form>
        </section>
        
        <!-- Talented Students Form (Example of another tab) -->
        <section id="talented" class="form-section">
            <h2 class="form-title">سجل المتفوقين والموهوبين</h2>
            <form id="talentedForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="talentName">اسم الطالب:</label>
                        <input type="text" id="talentName" placeholder="أدخل اسم الطالب">
                    </div>
                    <div class="form-group">
                        <label for="talentClass">الصف والشعبة:</label>
                        <input type="text" id="talentClass" placeholder="مثال: الأول ثانوي / أ">
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="talentAddress">العنوان:</label>
                    <input type="text" id="talentAddress" placeholder="أدخل عنوان الطالب">
                </div>
                
                <div class="form-group">
                    <label>صورة الطالب:</label>
                    <div class="image-upload" id="talentImageUpload">
                        <i class="fas fa-camera"></i>
                        <p>اضغط لالتقاط صورة أو اختيارها من المعرض</p>
                        <input type="file" id="talentImage" accept="image/*" capture="camera" class="hidden">
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="talentType">نوع التفوق أو الموهبة:</label>
                    <select id="talentType">
                        <option value="">اختر النوع</option>
                        <option value="academic">تفوق أكاديمي</option>
                        <option value="art">موهبة فنية</option>
                        <option value="sports">موهبة رياضية</option>
                        <option value="science">تميّز علمي</option>
                        <option value="leadership">قيادة</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="counselorServices">الخدمات التي قدمها المرشد:</label>
                    <textarea id="counselorServices" placeholder="اذكر الخدمات التي قدمتها"></textarea>
                </div>
                
                <div class="form-group">
                    <label for="careerGuidance">التوجيه المهني المناسب:</label>
                    <textarea id="careerGuidance" placeholder="اكتب التوجيه المهني المناسب لموهبة الطالب"></textarea>
                </div>
                
                <div class="form-group">
                    <label for="talentProblems">المشكلات التي يعاني منها الطالب:</label>
                    <textarea id="talentProblems" placeholder="اذكر أي مشكلات يعاني منها"></textarea>
                </div>
                
                <div class="form-group">
                    <label for="peerBehavior">السلوك التوافقي مع الأقران:</label>
                    <textarea id="peerBehavior" placeholder="صف سلوك الطالب مع زملائه"></textarea>
                </div>
                
                <div class="form-group">
                    <label for="talentActions">الإجراءات:</label>
                    <textarea id="talentActions" placeholder="اذكر الإجراءات المتخذة"></textarea>
                </div>
                
                <div class="form-group">
                    <label for="followUp">التقويم والمتابعة:</label>
                    <textarea id="followUp" placeholder="اكتب خطة المتابعة"></textarea>
                </div>
                
                <div class="btn-container">
                    <button type="button" class="btn btn-save"><i class="fas fa-save"></i> حفظ السجل</button>
                    <button type="button" class="btn btn-reset">مسح البيانات</button>
                </div>
            </form>
        </section>
        
        <!-- Other forms would be structured similarly -->
        <section id="key-record" class="form-section">
            <h2 class="form-title">سجل مفتاح الحالة</h2>
            <p style="text-align: center; padding: 30px; color: var(--gray);">سيتم إضافة نموذج سجل مفتاح الحالة هنا</p>
        </section>
        
        <section id="delayed" class="form-section">
            <h2 class="form-title">سجل الطلبة المتأخرين دراسياً</h2>
            <p style="text-align: center; padding: 30px; color: var(--gray);">سيتم إضافة نموذج الطلبة المتأخرين دراسياً هنا</p>
        </section>
        
        <!-- Additional sections would follow the same pattern -->
        
    </div>
    
    <!-- Navigation Bar -->
    <nav class="nav-bar">
        <a href="#" class="nav-item active">
            <div class="nav-icon"><i class="fas fa-home"></i></div>
            <span>الرئيسية</span>
        </a>
        <a href="#" class="nav-item">
            <div class="nav-icon"><i class="fas fa-clipboard-list"></i></div>
            <span>السجلات</span>
        </a>
        <a href="#" class="nav-item">
            <div class="nav-icon"><i class="fas fa-chart-line"></i></div>
            <span>التقارير</span>
        </a>
        <a href="#" class="nav-item">
            <div class="nav-icon"><i class="fas fa-cog"></i></div>
            <span>الإعدادات</span>
        </a>
    </nav>

    <script>
        // Tips database
        const tips = [
            "التفوق ليس هدفاً بل عادة يومية نمارسها باستمرار.",
            "الاستماع الجيد هو أول خطوات حل أي مشكلة تربوية.",
            "الطالب المتميز يحتاج إلى دعم نفسي وعاطفي أكثر من التركيز على الدرجات فقط.",
            "التعاون بين المرشد التربوي والمعلمين وأولياء الأمور هو أساس نجاح العملية الإرشادية.",
            "التحديات السلوكية لدى الطلاب غالباً ما تكون نداءً للاستعانة وليس عناداً.",
            "الاعتراف بالإنجازات الصغيرة للطلاب يعزز ثقتهم بأنفسهم وقدرتهم على التطور.",
            "بيئة الصف الإيجابية هي أفضل وقاية من المشاكل السلوكية.",
            "المرشد التربوي الناجح هو الذي يرى الإمكانات في كل طالب حتى عندما لا يراها الطالب نفسه."
        ];
        
        // DOM Elements
        const tipContent = document.getElementById('tipContent');
        const newTipBtn = document.getElementById('newTip');
        const shareTipBtn = document.getElementById('shareTip');
        const tabs = document.querySelectorAll('.tab');
        const formSections = document.querySelectorAll('.form-section');
        const imageUploads = document.querySelectorAll('.image-upload');
        
        // Initialize the app
        function initApp() {
            // Set today's date as default in date fields
            const today = new Date().toISOString().split('T')[0];
            document.querySelectorAll('input[type="date"]').forEach(input => {
                input.value = today;
            });
            
            // Load a random tip on startup
            loadRandomTip();
            
            // Set up event listeners
            setupEventListeners();
        }
        
        function setupEventListeners() {
            // Tip buttons
            newTipBtn.addEventListener('click', loadRandomTip);
            shareTipBtn.addEventListener('click', shareCurrentTip);
            
            // Tab navigation
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const tabId = tab.getAttribute('data-tab');
                    
                    // Update active tab
                    tabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    
                    // Show corresponding form
                    formSections.forEach(section => {
                        section.classList.remove('active');
                        if (section.id === tabId) {
                            section.classList.add('active');
                        }
                    });
                });
            });
            
            // Image upload handling
            imageUploads.forEach(upload => {
                upload.addEventListener('click', function() {
                    const fileInput = this.nextElementSibling;
                    if (fileInput) fileInput.click();
                });
                
                const fileInput = upload.nextElementSibling;
                if (fileInput) {
                    fileInput.addEventListener('change', function(e) {
                        if (e.target.files && e.target.files[0]) {
                            const reader = new FileReader();
                            
                            reader.onload = function(event) {
                                upload.innerHTML = `
                                    <img src="${event.target.result}" style="max-width: 100%; max-height: 150px; border-radius: 8px;">
                                    <p style="margin-top: 10px; color: var(--primary);">الصورة جاهزة للرفع</p>
                                `;
                            }
                            
                            reader.readAsDataURL(e.target.files[0]);
                        }
                    });
                }
            });
            
            // Save buttons
            document.querySelectorAll('.btn-save').forEach(button => {
                button.addEventListener('click', function() {
                    const formSection = this.closest('.form-section');
                    const formTitle = formSection.querySelector('.form-title').textContent;
                    
                    // Simple validation
                    const requiredFields = formSection.querySelectorAll('input[required], select[required], textarea[required]');
                    let isValid = true;
                    
                    requiredFields.forEach(field => {
                        if (!field.value.trim()) {
                            isValid = false;
                            field.style.borderColor = 'var(--warning)';
                            setTimeout(() => {
                                field.style.borderColor = '';
                            }, 3000);
                        }
                    });
                    
                    if (isValid) {
                        // In a real app, this would save to localStorage or IndexedDB
                        alert(`✅ تم حفظ ${formTitle} بنجاح!\n\nستظهر البيانات في التقارير والتقييمات.`);
                        
                        // Reset form
                        const form = formSection.querySelector('form');
                        if (form) form.reset();
                        
                        // Reset image previews
                        formSection.querySelectorAll('.image-upload').forEach(upload => {
                            if (upload.querySelector('img')) {
                                const fileInputId = upload.nextElementSibling.id;
                                upload.innerHTML = `
                                    <i class="fas fa-camera"></i>
                                    <p>اضغط لالتقاط صورة أو اختيارها من المعرض</p>
                                `;
                                document.getElementById(fileInputId).value = '';
                            }
                        });
                    } else {
                        alert('❌ يرجى ملء جميع الحقول المطلوبة قبل الحفظ');
                    }
                });
            });
            
            // Reset buttons
            document.querySelectorAll('.btn-reset').forEach(button => {
                button.addEventListener('click', function() {
                    if (confirm('هل أنت متأكد من مسح جميع البيانات في هذا النموذج؟')) {
                        const form = this.closest('form');
                        form.reset();
                        
                        // Reset image previews
                        const formSection = this.closest('.form-section');
                        formSection.querySelectorAll('.image-upload').forEach(upload => {
                            if (upload.querySelector('img')) {
                                const fileInputId = upload.nextElementSibling.id;
                                upload.innerHTML = `
                                    <i class="fas fa-camera"></i>
                                    <p>اضغط لالتقاط صورة أو اختيارها من المعرض</p>
                                `;
                                document.getElementById(fileInputId).value = '';
                            }
                        });
                    }
                });
            });
        }
        
        function loadRandomTip() {
            const randomIndex = Math.floor(Math.random() * tips.length);
            tipContent.textContent = tips[randomIndex];
            tipContent.classList.add('pulse');
            
            setTimeout(() => {
                tipContent.classList.remove('pulse');
            }, 400);
        }
        
        function shareCurrentTip() {
            const tipText = tipContent.textContent;
            const shareText = `نصيحة من تطبيق "إيقونة الإرشاد التربوي":\n\n${tipText}\n\nتطبيق يساعد المرشدين التربويين في متابعة الطلاب وخلق بيئة دراسية إيجابية.`;
            
            if (navigator.share) {
                navigator.share({
                    title: 'نصيحة تربوية',
                    text: shareText,
                    url: window.location.href
                })
                .then(() => console.log('نصيحة شاركت بنجاح!'))
                .catch(err => console.log('خطأ في المشاركة:', err));
            } else {
                // Fallback for browsers that don't support Web Share API
                navigator.clipboard.writeText(shareText)
                    .then(() => {
                        alert('✅ تم نسخ النصيحة إلى الحافظة! يمكنك لصقها في أي مكان.');
                    })
                    .catch(err => {
                        console.error('فشل في نسخ النص:', err);
                        alert('فشل في نسخ النص، يرجى النسخ يدوياً.');
                    });
            }
        }
        
        // Initialize the app when page loads
        document.addEventListener('DOMContentLoaded', initApp);
        
        // Handle offline functionality
        window.addEventListener('load', () => {
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('/service-worker.js')
                    .then(registration => {
                        console.log('ServiceWorker registered:', registration);
                    })
                    .catch(error => {
                        console.log('ServiceWorker registration failed:', error);
                    });
            }
        });
        
        // App cache manifest for offline support
        if ('caches' in window) {
            caches.open('guidance-app-v1').then(cache => {
                cache.addAll([
                    '/',
                    '/index.html',
                    '/style.css',
                    '/script.js',
                    '/manifest.json'
                ]);
            });
        }
    </script>
</body>
</html>
